@model IEnumerable<SistemaReserva.Models.Recepcionista>

@{
    ViewData["Title"] = "Gestión de Staff";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-user-shield me-2"></i>Gestión de Recepcionistas</h2>
        @* Aquí el botón clave para crear *@
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Nuevo Recepcionista
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Legajo</th>
                        <th>Nombre Completo</th>
                        <th>Email de Acceso</th>
                        <th>Fecha Ingreso</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-info text-dark">@item.Legajo</span>
                            </td>
                            <td>@item.Apellido, @item.Nombre</td>
                            <td>@item.Email</td>
                            <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                             <td>
                                @if (item.Activo)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Inactivo</span>
                                }
                            </td>
                            <td class="text-center" style="min-width: 180px;">
                                <div class="d-flex justify-content-center gap-2">
                                    @* Botón Editar *@
                                    <a asp-action="Edit" asp-route-id="@item.IdPersona" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit me-1"></i> Editar
                                    </a>
                                        @* Botón Toggle Estado (Alta/Baja) *@
                                    <form asp-action="ToggleEstado" asp-route-id="@item.IdPersona" method="post" class="d-inline">
                                        @if (item.Activo)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Dar de Baja">
                                                <i class="fas fa-user-slash"></i> Baja
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Dar de Alta">
                                                <i class="fas fa-user-check"></i> Alta
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>