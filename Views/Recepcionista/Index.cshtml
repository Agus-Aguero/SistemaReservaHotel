@model IEnumerable<SistemaReserva.Models.Recepcionista>

@{
    ViewData["Title"] = "Gestión de Staff";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-user-shield me-2"></i>Gestión de Recepcionistas</h2>
        @* Aquí el botón clave para crear *@
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Nuevo Recepcionista
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Legajo</th>
                        <th>Nombre Completo</th>
                        <th>Email de Acceso</th>
                        <th>Fecha Ingreso</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-info text-dark">@item.Legajo</span>
                            </td>
                            <td>@item.Apellido, @item.Nombre</td>
                            <td>@item.Email</td>
                            <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-warning" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.IdPersona" class="btn btn-sm btn-outline-info" title="Detalles">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @* Podríamos agregar un botón de Baja Lógica aquí *@
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>