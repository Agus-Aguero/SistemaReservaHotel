@using SistemaReserva.Patters
@model SistemaReserva.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
}

<h2>Nueva Reserva</h2>
<p class="text-muted">El huésped selecciona el tipo de habitación. El número se asignará al momento del ingreso.</p>

<hr />
<div class="row">
    <div class="col-md-6">
            @if (ViewData["IdPersona"] == null || !((SelectList)ViewData["IdPersona"]).Any())
            {
                <div class="alert alert-info shadow-sm">
                    <i class="fas fa-user-edit"></i> 
                    <strong>Perfil incompleto:</strong> Para realizar una reserva, primero necesitamos tus datos de contacto.
                    @* Cambiamos el controlador a Huesped *@
                    <a asp-controller="Huesped" asp-action="Create" class="btn btn-sm btn-info text-white ms-2">
                        Completar mis datos
                    </a>
                </div>
            }
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label">Seleccionar Huésped:</label>
                <select asp-for="IdPersona" class="form-control" asp-items="ViewBag.IdPersona">
                    <option value="">-- Seleccione el Huésped --</option>
                </select>
                <span asp-validation-for="IdPersona" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Categoría de Habitación:</label>
                <select asp-for="IdTipoHabitacion" class="form-control" asp-items="ViewBag.IdTipoHabitacion">
                    <option value="">-- Seleccione Tipo (Suite, Doble, etc.) --</option>
                </select>
                <span asp-validation-for="IdTipoHabitacion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Fecha de Entrada:</label>
                <input asp-for="FechaInicio" type="date" class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Fecha de Salida:</label>
                <input asp-for="FechaFin" type="date" class="form-control" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Datos del Huésped</label>
                
                @if (!SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios"))
                {
                    @* 1. Si es Huésped: Mostramos el combo bloqueado y un campo oculto *@
                    <select asp-for="IdPersona" class="form-control bg-light" 
                            asp-items='(SelectList)ViewData["IdPersona"]' disabled>
                    </select>
                    
                    @* El campo 'disabled' no se envía al servidor, así que necesitamos este hidden *@
                    <input type="hidden" asp-for="IdPersona" />
                }
                else
                {
                    @* 2. Si es Admin: Combo normal desplegable *@
                    <select asp-for="IdPersona" class="form-control" 
                            asp-items='(SelectList)ViewData["IdPersona"]'>
                        <option value="">-- Seleccione un Huésped --</option>
                    </select>
                }
                <span asp-validation-for="IdPersona" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success">Confirmar Reserva</button>
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
            </div>
        </form>
    </div>
</div>