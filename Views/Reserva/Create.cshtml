@using SistemaReserva.Patters
@model SistemaReserva.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
}

<h2>Nueva Reserva</h2>
<p class="text-muted">El número de habitación se asignará al momento del ingreso.</p>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold">Huésped Responsable:</label>
                
                @if (SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios") || SesionUsuario.Instancia.TienePermiso("Gestionar Huespedes")) 
                {
                    <div class="input-group">
                        <select asp-for="IdPersona" id="buscadorHuesped" asp-items='(SelectList)ViewData["IdPersona"]' style="width: 100%;">
                            <option value="">-- Escriba para buscar huésped --</option>
                        </select>
                    </div>
                }
                else
                {
                    @* Lógica para el huésped (Solo lectura) - INTACTA *@
                    var item = ((SelectList)ViewData["IdPersona"]).FirstOrDefault();
                    <input type="text" class="form-control bg-light" value="@(item?.Text ?? "Cargando...")" readonly />
                    <input type="hidden" asp-for="IdPersona" value="@(item?.Value ?? "")" />
                }
                <span asp-validation-for="IdPersona" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label fw-bold">Categoría de Habitación:</label>
                <select asp-for="IdTipoHabitacion" class="form-control" 
                        asp-items='@(new SelectList((IEnumerable<dynamic>)ViewBag.TiposConCamas, "IdTipoHabitacion", "DetalleFull"))'>
                    <option value="">-- Seleccione Tipo --</option>
                </select>
                <span asp-validation-for="IdTipoHabitacion" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="control-label fw-bold">Entrada:</label>
                    <input asp-for="FechaInicio" type="date" class="form-control" />
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="control-label fw-bold">Salida:</label>
                    <input asp-for="FechaFin" type="date" class="form-control" />
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-success px-4 shadow-sm">
                    <i class="fas fa-check-circle me-1"></i> Continuar al Pago
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>

            <div class="card bg-light border-primary mt-4">
                <div class="card-body">
                    <h5 class="card-title text-primary"><i class="fas fa-calculator me-2"></i>Presupuesto Estimado</h5>
                    <hr />
                    <div class="row text-center">
                        <div class="col-md-4">
                            <label class="d-block text-muted small">Noches</label>
                            <span id="resumenNoches" class="h4">0</span>
                        </div>
                        <div class="col-md-4">
                            <label class="d-block text-muted small">Total en ARS</label>
                            <span id="resumenARS" class="h4 text-success">$ 0.00</span>
                        </div>
                        <div class="col-md-4">
                            <label class="d-block text-muted small">Total en USD</label>
                            <span id="resumenUSD" class="h4 text-info">U$D 0.00</span>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<div id="reservaConfig" 
     data-precios='@Html.Raw(ViewBag.PreciosJson)' 
     data-cotizacion='@ViewBag.Cotizacion'>
</div>

@section Scripts {
    @* 1. Validaciones nativas (jQuery Validate) *@
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    @* 2. Estilos y Librería Select2 (CDN) *@
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    @* 3. Inicialización del buscador *@
    <script>
        $(document).ready(function() {
            // Buscamos el select por el ID exacto que le pusiste en tu HTML
            $('#buscadorHuesped').select2({
                placeholder: "-- Escriba para buscar huésped --",
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function() {
                        return "No se encontraron huéspedes";
                    }
                }
            });
        });
    </script>

    @* 4. Tu lógica de cálculo de presupuesto *@
    @* Asegurate de que la ruta coincida con la ubicación en wwwroot *@
    <script src="~/js/scripts.js"></script>
}