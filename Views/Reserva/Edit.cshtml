@model SistemaReserva.Models.Reserva

@{
    ViewData["Title"] = "Asignar Habitación / Editar Reserva";
}

<h2>Gestionar Reserva</h2>
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">Huésped: @Model.Huesped?.Apellido, @Model.Huesped?.Nombre</h5>
        <p class="card-text">
            <strong>Categoría Reservada:</strong> @Model.TipoHabitacion?.Nombre <br />
            <strong>Estadía:</strong> @Model.FechaInicio.ToShortDateString() al @Model.FechaFin.ToShortDateString()
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdReserva" />
            <input type="hidden" asp-for="IdPersona" />
            <input type="hidden" asp-for="Estado" />
            <input type="hidden" asp-for="IdTipoHabitacion" />

            <div class="form-group mb-3">
                <label class="control-label font-weight-bold">Asignar Habitación Física:</label>
                <select asp-for="IdHabitacion" class="form-control border-primary" asp-items="ViewBag.IdHabitacion">
                    <option value="">-- Seleccionar Habitación Libre --</option>
                </select>
                <small class="form-text text-muted">Solo se muestran habitaciones de tipo @Model.TipoHabitacion?.Nombre</small>
                <span asp-validation-for="IdHabitacion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaInicio" class="control-label"></label>
                <input asp-for="FechaInicio" class="form-control" type="date" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaFin" class="control-label"></label>
                <input asp-for="FechaFin" class="form-control" type="date" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success">Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>