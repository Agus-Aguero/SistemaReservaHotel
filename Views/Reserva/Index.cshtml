@using SistemaReserva.Patters
@model IEnumerable<SistemaReserva.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
    
    // 1. ¿Es empleado del hotel? (Admin, Recepción, Auditor)
    bool esStaff = SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios") || 
                   SesionUsuario.Instancia.TienePermiso("Gestionar Huespedes") ||
                   SesionUsuario.Instancia.TienePermiso("Ver Reservas") ||
                   SesionUsuario.Instancia.TienePermiso("Gestionar Habitaciones");
                   
    // 2. ¿Es staff operativo? (Solo los que pueden modificar/asignar)
    bool esStaffOperativo = SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios") || 
                            SesionUsuario.Instancia.TienePermiso("Gestionar Huespedes");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    @* TÍTULO DINÁMICO: Si es empleado dice Panel, si es cliente dice Mis Reservas *@
    <h1>@(esStaff ? "Panel de Reservas" : "Mis Reservas")</h1>
    
    @* BOTÓN NUEVA RESERVA: Lo ven los Huéspedes y el Staff Operativo *@
    @if (!esStaff || esStaffOperativo)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nueva Reserva
        </a>
    }
</div>

<hr />

@* --- ZONA DE ALERTAS (Acá el sistema te va a hablar) --- *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i> <strong>¡Atención!</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> <strong>¡Éxito!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@* -------------------------------------------------------- *@

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm">
        <h4 class="alert-heading">¡No hay reservas!</h4>
        <p>Todavía no se ha registrado ninguna reserva en el sistema. Haz clic en el botón azul para empezar.</p>
    </div>
}
else
{
    @* <table class="table table-striped table-hover mt-3 shadow-sm"> *@
    <table id="tablaReservas" class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Huésped</th>
                <th>Categoría</th>
                <th>Habitación</th>
                <th>Estado</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th class="text-center">Total</th>
                <th>Noches</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <div class="d-flex justify-content-between align-items-end mb-3">
            @* Botones de Moneda (Lo ven todos) *@
            <div>
                <span>Ver precios en: </span>
                <a asp-action="Index" asp-route-moneda="ARS" class="btn btn-sm @(ViewBag.Moneda == "ARS" ? "btn-dark" : "btn-outline-dark")">ARS ($)</a>
                <a asp-action="Index" asp-route-moneda="USD" class="btn btn-sm @(ViewBag.Moneda == "USD" ? "btn-success" : "btn-outline-success")">USD (U$D)</a>
            </div>

            @* Buscador (Solo lo ve el Staff) *@
            @if (esStaff)
            {
                <div class="input-group shadow-sm" style="max-width: 300px;">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="buscadorHuesped" class="form-control" placeholder="Buscar huésped...">
                </div>
            }
        </div>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @* 1. Huésped *@
                    <td>@(item.Huesped?.Apellido ?? "Sin Nombre"), @(item.Huesped?.Nombre ?? "")</td>
                    
                    @* 2. Categoría *@
                    <td>@item.TipoHabitacion?.Nombre</td>
                    
                    @* 3. Habitación *@
                    <td class="text-center">
                        @if (item.IdHabitacion.HasValue)
                        {
                            <span class="badge bg-success">@item.Habitacion?.Numero</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">⚠️ Pendiente</span>
                        }
                    </td>

                    @* 4. Estado *@
                    <td class="text-center">
                        @{
                            var claseEstado = item.Estado switch {
                                "Pendiente" => "bg-secondary",
                                "Activa" => "bg-primary",
                                "Hospedado" => "bg-success",
                                "Finalizada" => "bg-dark",
                                "Cancelada" => "bg-danger",
                                _ => "bg-info"
                            };
                        }
                        <span class="badge @claseEstado">@item.Estado</span>
                    </td>

                    @* 5. Entrada *@
                    <td data-sort="@item.FechaInicio.ToString("yyyy-MM-dd")">
                        @item.FechaInicio.ToString("d/M/yyyy")
                    </td>

                    @* 6. Salida *@
                    <td data-sort="@item.FechaFin.ToString("yyyy-MM-dd")">
                        @item.FechaFin.ToString("d/M/yyyy")
                    </td>

                    @* 7. Total *@
                    <td class="text-end">
                        <span class="fw-bold">
                            @if (ViewBag.Display != null)
                            {
                                @((ViewBag.Display as IPrecioDisplay).Formatear(item.PrecioTotal))
                            }
                            else
                            {
                                @item.PrecioTotal.ToString("C2") @:ARS
                            }
                        </span>
                    </td>

                    @* 8. Noches *@
                    <td class="text-center">
                        @{
                            int noches = (item.FechaFin - item.FechaInicio).Days;
                            if (noches <= 0) noches = 1;
                        }
                        @noches
                    </td>

                    @* 9. Acciones Corregidas *@
                    <td class="text-center" style="min-width: 200px;">
                        <div class="d-flex justify-content-center align-items-center gap-2">
                            @* A. GESTIÓN PARA STAFF (Admin o Recepcion) *@
                            @if (SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios") || SesionUsuario.Instancia.TienePermiso("Gestionar Huespedes"))
                            {
                                @* 1. ASIGNAR INICIAL *@
                                @if ((item.Estado == "Pendiente" || item.Estado == "Confirmada") && item.IdHabitacion == null)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-primary px-3 shadow-sm">
                                        <i class="fas fa-bed me-1"></i> Asignar
                                    </a>
                                }

                                @* 2. NUEVO: EDITAR / REASIGNAR *@
                                @if (item.IdHabitacion != null && (item.Estado == "Pendiente" || item.Estado == "Confirmada" || item.Estado == "Activa" || item.Estado == "Hospedado"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-warning px-3 shadow-sm text-dark" title="Editar Habitación">
                                        <i class="fas fa-edit me-1"></i> Editar
                                    </a>
                                }

                                @* CHECK-IN: Si tiene habitación asignada y está pendiente o confirmada *@
                                @if ((item.Estado == "Pendiente" || item.Estado == "Confirmada") && item.IdHabitacion != null)
                                {
                                    <form asp-action="CheckIn" asp-route-id="@item.IdReserva" method="post">
                                        <button type="submit" class="btn btn-sm btn-success px-3 shadow-sm">
                                            <i class="fas fa-door-open me-1"></i> Check-In
                                        </button>
                                    </form>
                                }

                                @* CHECK-OUT: Si la reserva está en curso (Activa o Hospedado) *@
                                @if (item.Estado == "Activa" || item.Estado == "Hospedado")
                                {
                                    <form asp-action="CheckOut" asp-route-id="@item.IdReserva" method="post">
                                        <button type="submit" class="btn btn-sm btn-info text-white px-3 shadow-sm">
                                            <i class="fas fa-sign-out-alt me-1"></i> Check-Out
                                        </button>
                                    </form>
                                }
                            }

                            @* CANCELAR: Visible si está Pendiente o Confirmada *@
                            @if (item.Estado == "Pendiente" || item.Estado == "Confirmada")
                            {
                                <form asp-action="Cancel" asp-route-id="@item.IdReserva" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger px-3 shadow-sm" title="Cancelar" onclick="return confirm('¿Confirmar cancelación?')">
                                        <i class="fas fa-times me-1"></i> Cancelar
                                    </button>
                                </form>
                            }

                            @if (item.Cobro != null && item.Cobro.Estado == "Pendiente de Comprobante")
                            {
                                <form asp-controller="Cobro" asp-action="AprobarTransferencia" method="post" class="d-inline">
                                    <input type="hidden" name="idCobro" value="@item.Cobro.IdCobro" />
                                    <button type="submit" class="btn btn-success btn-sm text-nowrap" title="Aprobar Transferencia" onclick="return confirm('¿Confirmas que el dinero ya impactó en el banco?');">
                                        <i class="fas fa-check-double"></i> Aprobar Pago
                                    </button>
                                </form>
                            }

                            @if (item.Cobro != null && item.Cobro.Estado == "En Garantía")
                            {
                                // Validamos que la fecha de check-in sea HOY (o anterior)
                                @if (item.FechaInicio.Date <= DateTime.Today)
                                {
                                    <form asp-controller="Cobro" asp-action="EjecutarCobroGarantia" method="post" class="d-inline">
                                        <input type="hidden" name="idCobro" value="@item.Cobro.IdCobro" />
                                        
                                        <button type="submit" class="btn btn-success btn-sm text-nowrap" onclick="return confirm('¿Ya pasaste la tarjeta física por el Posnet del hotel?');">
                                            <i class="fas fa-check-circle"></i> Aprobar Pago
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 0.85em;">
                                        <i class="fas fa-calendar-alt"></i> Se cobra el @item.FechaInicio.ToString("dd/MM")
                                    </span>
                                }
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
   @section Scripts {
    <!-- 1. Estilos de DataTables para Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <!-- 2. Scripts principales -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script> 
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- 3. Lógica combinada -->
   <script>
    $(document).ready(function () {
        
        var table = $('#tablaReservas').DataTable({
            "language": {
                "lengthMenu": "Mostrar _MENU_ registros",
                "zeroRecords": "No se encontraron resultados",
                "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                "infoEmpty": "Mostrando 0 a 0 de 0 registros",
                "infoFiltered": "(filtrado de _MAX_ registros totales)",
                "search": "Buscar:",
                "paginate": {
                    "first": "Primero",
                    "last": "Último",
                    "next": "Siguiente",
                    "previous": "Anterior"
                },
                "loadingRecords": "Cargando...",
                "processing": "Procesando...",
                "emptyTable": "No hay datos disponibles en la tabla"
            },
            
            "pageLength": 15,
            "lengthMenu": [5, 10, 15, 25, 50],
            
            "order": [[8, "desc"]], 
            
            "dom": "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'>>" +
                   "<'row'<'col-sm-12'tr>>" +
                   "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
        });

        const inputBuscador = document.getElementById('buscadorHuesped');
        
        if (inputBuscador) {
            inputBuscador.addEventListener('input', function (e) {
                table.search(e.target.value).draw();
            });
        }
    });
</script>
}
    
}