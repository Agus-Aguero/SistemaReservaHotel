@using SistemaReserva.Patters
@model IEnumerable<SistemaReserva.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Gestión de Reservas</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nueva Reserva
    </a>
</div>

<hr />

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm">
        <h4 class="alert-heading">¡No hay reservas!</h4>
        <p>Todavía no se ha registrado ninguna reserva en el sistema. Haz clic en el botón azul para empezar.</p>
    </div>
}
else
{
    <table class="table table-striped table-hover mt-3 shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Huésped</th>
                <th>Categoría</th>
                <th>Habitación</th>
                <th>Estado</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th class="text-center">Total</th>
                <th>Noches</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <div class="mb-3">
                <span>Ver precios en: </span>
                <a asp-action="Index" asp-route-moneda="ARS" class="btn btn-sm @(ViewBag.Moneda == "ARS" ? "btn-dark" : "btn-outline-dark")">ARS ($)</a>
                <a asp-action="Index" asp-route-moneda="USD" class="btn btn-sm @(ViewBag.Moneda == "USD" ? "btn-success" : "btn-outline-success")">USD (U$D)</a>
        </div>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @* 1. Huésped *@
                    <td>@(item.Huesped?.Apellido ?? "Sin Nombre"), @(item.Huesped?.Nombre ?? "")</td>
                    
                    @* 2. Categoría *@
                    <td>@item.TipoHabitacion?.Nombre</td>
                    
                    @* 3. Habitación *@
                    <td class="text-center">
                        @if (item.IdHabitacion.HasValue)
                        {
                            <span class="badge bg-success">@item.Habitacion?.Numero</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">⚠️ Pendiente</span>
                        }
                    </td>

                    @* 4. Estado *@
                    <td class="text-center">
                        @{
                            var claseEstado = item.Estado switch {
                                "Pendiente" => "bg-secondary",
                                "Activa" => "bg-primary",
                                "Hospedado" => "bg-success",
                                "Finalizada" => "bg-dark",
                                "Cancelada" => "bg-danger",
                                _ => "bg-info"
                            };
                        }
                        <span class="badge @claseEstado">@item.Estado</span>
                    </td>

                    @* 5. Entrada *@
                    <td>@item.FechaInicio.ToShortDateString()</td>

                    @* 6. Salida *@
                    <td>@item.FechaFin.ToShortDateString()</td>

                    @* 7. Total *@
                    <td class="text-end">
                        <span class="fw-bold">
                            @if (ViewBag.Display != null)
                            {
                                @((ViewBag.Display as IPrecioDisplay).Formatear(item.PrecioTotal))
                            }
                            else
                            {
                                @item.PrecioTotal.ToString("C2") @:ARS
                            }
                        </span>
                    </td>

                    @* 8. Noches *@
                    <td class="text-center">
                        @{
                            int noches = (item.FechaFin - item.FechaInicio).Days;
                            if (noches <= 0) noches = 1;
                        }
                        @noches
                    </td>

                    @* 9. Acciones Corregidas *@
                    <td class="text-center" style="min-width: 200px;">
                        <div class="d-flex justify-content-center align-items-center gap-2">
                            @* A. GESTIÓN PARA STAFF (Admin o Recepcion) *@
                            @if (SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios") || SesionUsuario.Instancia.TienePermiso("Recepcion"))
                            {
                                @* ASIGNAR: Si está pendiente y sin nro de habitación *@
                                @if (item.Estado == "Pendiente" && item.IdHabitacion == null)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-primary px-3">
                                        <i class="fas fa-bed me-1"></i> Asignar
                                    </a>
                                }

                                @* CHECK-IN: Si tiene habitación pero sigue pendiente *@
                                @if (item.Estado == "Pendiente" && item.IdHabitacion != null)
                                {
                                    <form asp-action="CheckIn" asp-route-id="@item.IdReserva" method="post">
                                        <button type="submit" class="btn btn-sm btn-success px-3">
                                            <i class="fas fa-door-open me-1"></i> Check-In
                                        </button>
                                    </form>
                                }

                                @* CHECK-OUT: Si la reserva está en curso (Activa o Hospedado) *@
                                @if (item.Estado == "Activa" || item.Estado == "Hospedado")
                                {
                                    <form asp-action="CheckOut" asp-route-id="@item.IdReserva" method="post">
                                        <button type="submit" class="btn btn-sm btn-info text-white px-3">
                                            <i class="fas fa-sign-out-alt me-1"></i> Check-Out
                                        </button>
                                    </form>
                                }
                            }

                            @* B. CANCELAR: Visible si está Pendiente y tiene el permiso *@
                            @if (item.Estado == "Pendiente" && SesionUsuario.Instancia.TienePermiso("Cancelar Reserva"))
                            {
                                <form asp-action="Cancel" asp-route-id="@item.IdReserva" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Confirmar cancelación?')">
                                        <i class="fas fa-times"></i> Cancelar
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}