@model SistemaReserva.Models.ForgotPasswordViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h4>Recuperar Acceso - ArgenTower</h4>
                </div>
                <div class="card-body">
                    <form asp-action="ForgotPassword" method="post">
                        @* UNICO hidden global: El paso actual *@
                        <input type="hidden" asp-for="Paso" />

                        @* PASO 1: Ingreso de Email *@
                        @if (Model.Paso == 1)
                        {
                            <p class="text-muted">Ingresa tu email para comenzar el proceso.</p>
                            <div class="form-group mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        }

                        @* PASO 2: Pregunta de Seguridad *@
                        @if (Model.Paso == 2)
                        {
                            @* Guardamos Email y Pregunta para el POST del paso 2 *@
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="Pregunta" />

                            <div class="alert alert-info">
                                <strong>Pregunta de Seguridad:</strong><br />
                                @Model.Pregunta
                            </div>
                            <div class="form-group mb-3">
                                <label>Tu Respuesta</label>
                                <input asp-for="Respuesta" class="form-control" autofocus />
                                <span asp-validation-for="Respuesta" class="text-danger"></span>
                            </div>
                        }

                        @* PASO 3: Nueva Contraseña *@
                        @if (Model.Paso == 3)
                        {
                            @* Guardamos Email y Respuesta (o solo Email según tu lógica) *@
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="Respuesta" />

                            <div class="form-group mb-3">
                                <label>Nueva Contraseña</label>
                                <input asp-for="NuevaPassword" class="form-control" autofocus />
                                <span asp-validation-for="NuevaPassword" class="text-danger"></span>
                            </div>
                        }

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                @(Model.Paso == 3 ? "Restablecer Contraseña" : "Continuar")
                            </button>
                            <a asp-action="Login" class="btn btn-link">Volver al Login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>