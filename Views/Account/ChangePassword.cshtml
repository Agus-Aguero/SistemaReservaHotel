@model SistemaReserva.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0"><i class="fas fa-lock-open me-2"></i>Seguridad de la Cuenta</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small text-center mb-4">
                        Por tu seguridad, te recomendamos usar una combinación de letras, números y símbolos.
                    </p>

                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-key"></i></span>
                                <input asp-for="CurrentPassword" class="form-control" placeholder="Contraseña actual" />
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="form-group mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-plus-circle"></i></span>
                                <input asp-for="NewPassword" class="form-control" placeholder="Nueva contraseña" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-check-double"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repetir nueva contraseña" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                Actualizar Contraseña
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-link text-secondary">
                                Cancelar y volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}