@model SistemaReserva.Models.Huesped

@{
    ViewData["Title"] = "Completar Datos";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0"><i class="fas fa-user-check me-2"></i>¡Casi listo!</h3>
                    <p class="mb-0">Necesitamos unos datos básicos para tu primera reserva</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CompleteData" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Email" />   
                        <div asp-validation-summary="All" class="text-danger"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label fw-bold"></label>
                                <div asp-validation-summary="All" class="text-danger"></div>
                                <input asp-for="Nombre" class="form-control" placeholder="Tu nombre" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellido" class="form-label fw-bold"></label>
                                <div asp-validation-summary="All" class="text-danger"></div>
                                <input asp-for="Apellido" class="form-control" placeholder="Tu apellido" />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaNacimiento" class="form-label fw-bold"></label>
                                <div asp-validation-summary="All" class="text-danger"></div>
                                <input asp-for="FechaNacimiento" type="date" class="form-control" />
                                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono" class="form-label fw-bold"></label>
                                <div asp-validation-summary="All" class="text-danger"></div>
                                <input asp-for="Telefono" class="form-control" placeholder="Ej: +54 9 11..." />
                                <span asp-validation-for="Telefono" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Ciudad" class="form-label fw-bold"></label>
                            <div asp-validation-summary="All" class="text-danger"></div>
                            <input asp-for="Ciudad" class="form-control" placeholder="Ciudad de residencia" />
                            <span asp-validation-for="Ciudad" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm">
                                <i class="fas fa-save me-2"></i>Guardar y Continuar
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-link text-muted">Luego lo haré</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}