@model SistemaReserva.Models.RegisterViewModel

@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0">🏨 Registro de Huésped</h3>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">Crea tu cuenta para gestionar tus reservas.</p>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" placeholder="nombre@ejemplo.com" />
                            <label asp-for="Email">Correo Electrónico</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Password" class="form-control" type="password" placeholder="Contraseña" />
                            <label asp-for="Password">Contraseña</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirmar Contraseña" />
                            <label asp-for="ConfirmPassword">Confirmar Contraseña</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                        <label asp-for="PreguntaSeguridad" class="control-label fw-bold"></label>
                        <select asp-for="PreguntaSeguridad" class="form-control">
                            <option value="">-- Seleccione una pregunta --</option>
                            <option value="¿Nombre de tu primera mascota?">¿Nombre de tu primera mascota?</option>
                            <option value="¿Ciudad donde naciste?">¿Ciudad donde naciste?</option>
                            <option value="¿Color favorito?">¿Color favorito?</option>
                            <option value="¿Año de nacimiento de tu madre?">¿Año de nacimiento de tu madre?</option>
                            <option value="¿Nombre de tu escuela primaria?">¿Nombre de tu escuela primaria?</option>
                            <option value="¿Marca de tu primer auto?">¿Marca de tu primer auto?</option>
                        </select>
                        <span asp-validation-for="PreguntaSeguridad" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="RespuestaSeguridad" class="control-label fw-bold"></label>
                        <input asp-for="RespuestaSeguridad" class="form-control" placeholder="Tu respuesta secreta" />
                        <span asp-validation-for="RespuestaSeguridad" class="text-danger"></span>
                    </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-person-plus-fill"></i> Registrarse
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3 bg-light">
                    <span class="text-muted">¿Ya tienes cuenta?</span> 
                    <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Inicia sesión aquí</a>
                </div>
            </div>
            
            <div class="text-center mt-3">
                <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none small">
                    ← Volver al inicio
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}