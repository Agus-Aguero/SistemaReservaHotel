@using SistemaReserva.Patters
@model SistemaReserva.Models.Huesped

@{
    ViewData["Title"] = "Crear Huesped";
}

@{
    bool esAdmin = SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios");
    ViewData["Title"] = esAdmin ? "Nuevo Huésped" : "Completar mi Perfil";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            @* --- COLUMNA IZQUIERDA --- *@
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="control-label font-weight-bold"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese nombre" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Apellido" class="control-label font-weight-bold"></label>
                    <input asp-for="Apellido" class="form-control" placeholder="Ingrese apellido" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="control-label font-weight-bold"></label>
                    @if (esAdmin)
                    {
                        <input asp-for="Email" class="form-control" />
                    }
                    else
                    {
                        <input asp-for="Email" class="form-control bg-light" readonly />
                    }
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            @* --- COLUMNA DERECHA --- *@
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Telefono" class="control-label font-weight-bold"></label>
                    <input asp-for="Telefono" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="FechaNacimiento" class="control-label font-weight-bold"></label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Pais" class="control-label font-weight-bold"></label>
                    <input asp-for="Pais" class="form-control" />
                    <span asp-validation-for="Pais" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Ciudad" class="control-label font-weight-bold"></label>
                    <input asp-for="Ciudad" class="form-control" />
                    <span asp-validation-for="Ciudad" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="@(esAdmin ? "Crear Huésped" : "Guardar Perfil")" class="btn btn-primary px-4" />
            
            @if (esAdmin)
            {
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver al Listado</a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
            }
        </div>
    </form>
</div>