@using SistemaReserva.Patters
@model SistemaReserva.Models.Huesped

@{
    bool esAdmin = SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios") || SesionUsuario.Instancia.TienePermiso("Recepcion");
    ViewData["Title"] = esAdmin ? "Registrar Nuevo Huésped" : "Completar mi Perfil";
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white py-3">
            <h4 class="mb-0">
                <i class="fas @(esAdmin ? "fa-user-plus" : "fa-user-circle") me-2"></i>@ViewData["Title"]
            </h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h5 class="text-primary border-bottom pb-2 mb-3">Datos de Identidad y Acceso</h5>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Nombre" class="form-label fw-bold"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Nombre completo" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Apellido" class="form-label fw-bold"></label>
                        <input asp-for="Apellido" class="form-control" placeholder="Apellido completo" />
                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Correo Electrónico (Usuario)</label>
                        @if (esAdmin)
                        {
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="huesped@correo.com" />
                            </div>
                            <small class="text-info">Se creará acceso automático con clave: <strong>1234</strong></small>
                        }
                        else
                        {
                            <input asp-for="Email" class="form-control bg-light" readonly />
                            <small class="text-muted">Este correo es tu identificador de acceso.</small>
                        }
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <h5 class="text-primary border-bottom pb-2 mt-4 mb-3">Información de Contacto y Origen</h5>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="FechaNacimiento" class="form-label fw-bold">Fecha de Nacimiento</label>
                        <input asp-for="FechaNacimiento" type="date" class="form-control" />
                        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Telefono" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-phone"></i></span>
                            <input asp-for="Telefono" class="form-control" placeholder="+54..." />
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Nacionalidad" class="form-label fw-bold"></label>
                        <input asp-for="Nacionalidad" class="form-control" placeholder="Ej: Argentina" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Pais" class="form-label fw-bold"></label>
                        <input asp-for="Pais" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Ciudad" class="form-label fw-bold"></label>
                        <input asp-for="Ciudad" class="form-control" />
                    </div>
                </div>

                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary px-5 shadow-sm">
                        <i class="fas fa-save me-2"></i>@(esAdmin ? "Crear Huésped" : "Guardar Perfil")
                    </button>
                    
                    @if (esAdmin)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Volver al Listado</a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}