@using SistemaReserva.Patters @* <--- Asegurate que este sea el namespace de tu Singleton *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaReserva</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaReserva.styles.css" asp-append-version="true" />
</head>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SistemaReserva</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">🏠 Inicio</a>
                        </li>

                        @if (SesionUsuario.Instancia.Email != null)
                        {
                            @* 1. Usuarios e informe de Permisos (Admin) *@
                            if (SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownPersonas" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        👥 Usuarios
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navbarDropdownPersonas">
                                        <li><a class="dropdown-item" asp-controller="Huesped" asp-action="Index">Huéspedes</a></li>
                                        <li><a class="dropdown-item" asp-controller="Persona" asp-action="Index">Todas las Personas</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-primary" asp-controller="Permisos" asp-action="Gestionar" asp-route-idUsuario="1">🌳 Ver Árbol de Permisos</a></li>
                                    </ul>
                                </li>
                            }

                            @* 2. Infraestructura (Admin) *@
                            if (SesionUsuario.Instancia.TienePermiso("Gestionar Habitaciones"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownHab" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        🏨 Infraestructura
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navbarDropdownHab">
                                        <li><a class="dropdown-item" asp-controller="Habitacion" asp-action="Index">Listado de Habitaciones</a></li>
                                        <li><a class="dropdown-item" asp-controller="TipoHabitacion" asp-action="Index">Tipos de Habitación</a></li>
                                    </ul>
                                </li>
                            }

                            @* 3. Reservas (Todos con permiso) *@
                            if (SesionUsuario.Instancia.TienePermiso("Ver Reservas") || SesionUsuario.Instancia.TienePermiso("Crear Reserva"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold" asp-controller="Reserva" asp-action="Index">📅 Reservas</a>
                                </li>
                            }

                            @* 4. MI CUENTA (Lado derecho) *@
                            <li class="nav-item dropdown ms-auto">
                                <a class="nav-link dropdown-toggle btn btn-light border-0" href="#" id="navbarDropdownUser" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    👤 @SesionUsuario.Instancia.Email
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="navbarDropdownUser">
                                    
                                    @* Ocultamos "Mis Datos" para cualquier Administrador *@
                                    @if (!SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Huesped" asp-action="DetailsAccount">
                                                <i class="fas fa-id-card"></i> Mis Datos (Perfil)
                                            </a>
                                        </li>
                                    }

                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                            <i class="fas fa-key"></i> Cambiar Contraseña
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>
                                    
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            @* BOTÓN DE INGRESAR CUANDO NO HAY SESIÓN *@
                            <li class="nav-item ms-auto">
                                <a class="nav-link btn btn-outline-primary px-4" asp-controller="Account" asp-action="Login">🔑 Ingresar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>⚠️ Acceso Denegado:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SistemaReserva - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>