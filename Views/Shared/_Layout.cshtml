@using SistemaReserva.Patters

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaReserva</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaReserva.styles.css" asp-append-version="true" />
</head>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<body style="background-color: #ececee;">
    <header>
    @* CAMBIO 1: navbar-dark para texto claro y background-color con el azul de ArgenTower *@
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3" style="background-color: #3a539b;">
        <div class="container-fluid">
            
            @* CAMBIO 2: Integra el Logo y el nombre Argen Tower *@
            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                @* Ajusta el height (40px) si el logo es muy grande o muy chico *@
                <img src="~/images/Logo.png" alt="Argen Tower Logo" style="height: 55px; margin-right: 15px;" />
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        @* CAMBIO 3: text-white en lugar de text-dark *@
                        <a class="nav-link text-white" asp-controller="Home" asp-action="Index">🏠 Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Habitaciones">
                            🛏️ Nuestras Habitaciones
                        </a>
                    </li>

                    @if (SesionUsuario.Instancia.Email != null)
                    {
                        @* 1. Menú de Usuarios *@
                        @if (SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios") ||
                       SesionUsuario.Instancia.TienePermiso("Gestionar Huespedes"))
                        {
                            <li class="nav-item dropdown">
                                @* CAMBIO 3: text-white *@
                                <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdownPersonas" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    👥 Usuarios
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdownPersonas">
                                    @* Los items del dropdown siguen siendo oscuros porque el fondo del dropdown es blanco *@
                                    @if (SesionUsuario.Instancia.TienePermiso("Gestionar Huespedes") ||
                                   SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Huesped" asp-action="Index">Huéspedes</a></li>
                                    }

                                    @if (SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Recepcionista" asp-action="Index">Recepcionistas</a></li>
                                        <li><a class="dropdown-item" asp-controller="Grupo" asp-action="Index">Gestión de Grupos</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        

                        @* 2. Infraestructura (Admin y Recepción) *@
                        @if (SesionUsuario.Instancia.TienePermiso("Gestionar Habitaciones") || SesionUsuario.Instancia.TienePermiso("Recepcion"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdownHab" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    🏨 Infraestructura
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdownHab">
                                    
                                    @* Esta opción la ven ambos (Admin y Recepcionista) *@
                                    <li><a class="dropdown-item" asp-controller="Habitacion" asp-action="Index">Listado de Habitaciones</a></li>
                                    
                                    @* Esta opción de configuración avanzada SOLO la ve el Admin *@
                                    @if (SesionUsuario.Instancia.TienePermiso("Gestionar Habitaciones"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="TipoHabitacion" asp-action="Index">Tipos de Habitación</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @* 3. Sección de Reservas y Gestión Operativa *@
                        @if (SesionUsuario.Instancia.TienePermiso("Ver Reservas"))
                        {
                            @* Si es Admin o Recepcionista *@
                            if (SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios") ||
                           SesionUsuario.Instancia.TienePermiso("CheckIn"))
                            {
                                <li class="nav-item">
                                    @* CAMBIO 3: text-white *@
                                    <a class="nav-link text-white fw-bold" asp-controller="Reserva" asp-action="Index">📋 Panel de Reservas</a>
                                </li>
                            }
                            else @* Es un Huésped *@
                            {
                                <li class="nav-item">
                                    @* CAMBIO 3: text-white *@
                                    <a class="nav-link text-white fw-bold" asp-controller="Reserva" asp-action="Index">📅 Mis Reservas</a>
                                </li>
                            }
                        }

                        @if (SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Reportes" asp-action="Index">
                                    📊 Reportes
                                </a>
                            </li>
                            <li><a class="dropdown-item" asp-controller="Usuario" asp-action="Index">Auditoría de Usuarios</a></li>
                        }

                        @* 4. MI CUENTA (Lado derecho) *@
                        <li class="nav-item dropdown ms-auto">
                            @* CAMBIO 4: Quitamos 'btn btn-light' para que sea un link limpio blanco *@
                            <a class="nav-link dropdown-toggle text-white fw-bold" href="#" id="navbarDropdownUser" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                👤 @SesionUsuario.Instancia.Email
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="navbarDropdownUser">

                                @if (!SesionUsuario.Instancia.TienePermiso("Gestionar Usuarios"))
                                {
                                    <a class="dropdown-item" asp-controller="Account" asp-action="MiPerfil">
                                        <i class="fas fa-id-card"></i> Mis Datos (Perfil)
                                    </a>
                                }

                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="fas fa-key"></i> Cambiar Contraseña
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                        <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        @* BOTÓN DE INGRESAR CUANDO NO HAY SESIÓN *@
                        <li class="nav-item ms-auto">
                            <a class="btn btn-light px-4 fw-bold" 
                            style="color: #3a539b;" 
                            asp-controller="Account" asp-action="Login">
                            🔑 Ingresar
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>⚠️ Acceso Denegado:</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SistemaReserva - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Tu nuevo archivo centralizado *@
    <script src="~/js/scripts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>