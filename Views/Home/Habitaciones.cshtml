@model IEnumerable<SistemaReserva.Models.TipoHabitacion>

@{
    ViewData["Title"] = "Nuestras Habitaciones";
    // Por si el controlador no manda la moneda, asumimos ARS por defecto
    string monedaActual = ViewBag.Moneda as string ?? "ARS";
}

<div class="text-center mb-4">
    <h1 class="display-4 fw-bold text-primary">Nuestras Habitaciones</h1>
    <p class="lead text-muted">Confort y elegancia en todo su esplendor.</p>
</div>

<div class="container mb-4 d-flex justify-content-end">
    <div class="btn-group shadow-sm" role="group" aria-label="Selector de moneda">
        <a asp-action="Habitaciones" asp-route-moneda="ARS" 
           class="btn btn-outline-success @(monedaActual == "ARS" ? "active fw-bold" : "")">
           <i class="fas fa-money-bill-wave me-1"></i> ARS ($)
        </a>
        <a asp-action="Habitaciones" asp-route-moneda="USD" 
           class="btn btn-outline-success @(monedaActual == "USD" ? "active fw-bold" : "")">
           <i class="fas fa-dollar-sign me-1"></i> USD(u$d)
        </a>
    </div>
</div>

<div class="container">
    @foreach (var item in Model)
    {
        <div class="card shadow-sm border-0 mb-5 overflow-hidden">
            <div class="card-body p-0">
                <div class="row g-0">
                    
                    @* COLUMNA 1: Información *@
                    <div class="col-md-5 p-5 d-flex flex-column justify-content-center bg-white">
                        <h2 class="card-title text-primary fw-bold mb-3">@item.Nombre</h2>
                        
                        <div class="mb-3">
                            <span class="badge bg-info text-dark mb-2">
                                <i class="fas fa-user-friends me-1"></i> Capacidad: @item.Capacidad personas
                            </span>
                        </div>

                        <p class="card-text text-muted">
                            @item.DescripcionCamas. Disfrute de una estadía inolvidable con todas las comodidades que ArgenTower tiene para ofrecer.
                        </p>

                        @* LÓGICA DEL DECORATOR PARA EL PRECIO *@
                        <h3 class="text-success fw-bold my-3">
                            @if (ViewBag.Display != null)
                            {
                                @ViewBag.Display.Formatear(item.PrecioBase)
                            }
                            else
                            {
                                <span>$ @item.PrecioBase.ToString("N0") ARS</span>
                            }
                            <small class="text-muted fs-6">/ noche</small>
                        </h3>

                        @* LÓGICA DEL BOTÓN DE RESERVA *@
                        @if (string.IsNullOrEmpty(SistemaReserva.Patters.SesionUsuario.Instancia.Email))
                        {
                            <a asp-controller="Account" asp-action="Login" 
                            class="btn btn-secondary btn-lg rounded-pill shadow mt-2"
                            title="Debes iniciar sesión para reservar">
                                <i class="fas fa-user-lock me-2"></i> Inicia Sesión para Reservar
                            </a>
                            <div class="mt-2">
                                <small class="text-muted">¿No tienes cuenta? <a asp-controller="Account" asp-action="Register" class="text-primary fw-bold">Regístrate aquí</a></small>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Reserva" asp-action="Create" asp-route-idTipoPreseleccionado="@item.IdTipoHabitacion" 
                            class="btn btn-primary btn-lg rounded-pill shadow mt-2">
                                Reservar Ahora <i class="fas fa-arrow-right ms-2"></i>
                            </a>
                        }
                    </div>

                    @* COLUMNA 2: Imágenes (Galería simple) *@
                    <div class="col-md-7 bg-light">
                        <div class="row g-0 h-100">
                            <div class="col-8 h-100">
                                <img src="~/images/habitaciones/tipo-@(item.IdTipoHabitacion)-main.jpg" 
                                     onerror="this.src='https://placehold.co/600x400?text=Foto+Principal'"
                                     class="img-fluid h-100 w-100" 
                                     style="object-fit: cover; min-height: 300px;" 
                                     alt="@item.Nombre Principal">
                            </div>
                            <div class="col-4 d-flex flex-column h-100">
                                <img src="~/images/habitaciones/tipo-@(item.IdTipoHabitacion)-1.jpg" 
                                     onerror="this.src='https://placehold.co/300x200?text=Detalle+1'"
                                     class="img-fluid h-50 w-100 border-bottom border-white" 
                                     style="object-fit: cover;" 
                                     alt="Detalle">
                                     
                                <img src="~/images/habitaciones/tipo-@(item.IdTipoHabitacion)-2.jpg" 
                                     onerror="this.src='https://placehold.co/300x200?text=Detalle+2'"
                                     class="img-fluid h-50 w-100" 
                                     style="object-fit: cover;" 
                                     alt="Baño">
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }
</div>