@model IEnumerable<SistemaReserva.Models.Habitacion>

@{
    ViewData["Title"] = "Listado de Habitaciones";
}

<h1>Gestión de Habitaciones</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar Nueva Habitación</a>
</p>

<table class="table table-striped border">
    <thead class="thead-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Numero)</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Numero</td>
                <td>@(item.Tipo?.Nombre ?? "Sin asignar")</td>
                <td>@(item.Tipo?.PrecioBase.ToString("C2") ?? "$0.00")</td>
                <td>
                    @if (item.Disponible)
                    {
                        <span class="badge" style="background-color: green; color: white; padding: 5px; border-radius: 5px;">Disponible</span>
                    }
                    else
                    {
                        <span class="badge" style="background-color: red; color: white; padding: 5px; border-radius: 5px;">Ocupada</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdHabitacion" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdHabitacion" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>