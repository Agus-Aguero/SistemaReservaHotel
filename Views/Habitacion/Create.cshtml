@model SistemaReserva.Models.Habitacion

@{
    ViewData["Title"] = "Nueva Habitación";
}

<h2>Registrar Nueva Habitación</h2>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Numero" class="control-label">Número de Habitación</label>
                <input asp-for="Numero" class="form-control" placeholder="Ej: 101" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdTipoHabitacion" class="control-label">Tipo de Habitación</label>
                <select asp-for="IdTipoHabitacion" class="form-control" asp-items="ViewBag.IdTipoHabitacion">
                    <option value="">-- Seleccione un Tipo --</option>
                </select>
                <span asp-validation-for="IdTipoHabitacion" class="text-danger"></span>
            </div>

            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Disponible" /> @Html.DisplayNameFor(model => model.Disponible)
                </label>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar Habitación" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>