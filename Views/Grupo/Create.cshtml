@{
    ViewData["Title"] = "Crear Nuevo Grupo";
    // Traemos la lista de patentes (permisos) que mandamos desde el controlador
    var permisos = ViewBag.PermisosDisponibles as List<SistemaReserva.Models.Seguridad.Patente>;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white">
                    <h3 class="mb-0"><i class="fas fa-shield-alt me-2"></i> Crear Nuevo Grupo (Rol)</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label for="nombre" class="form-label fw-bold">Nombre del Grupo</label>
                            <input type="text" class="form-control form-control-lg" id="nombre" name="nombre" placeholder="Ej: Auditoría, Limpieza, RRHH" required autocomplete="off" />
                        </div>

                        <div class="bg-light p-3 rounded border">
                            <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary">Asignar Permisos al Grupo</h5>
                            <div class="row">
                                @if (permisos != null && permisos.Any())
                                {
                                    foreach (var permiso in permisos)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input fs-5" type="checkbox" name="permisosSeleccionados" value="@permiso.IdComponente" id="permiso_@permiso.IdComponente">
                                                <label class="form-check-label pt-1 ms-2 user-select-none" for="permiso_@permiso.IdComponente" style="cursor: pointer;">
                                                    @permiso.Nombre
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12">
                                        <p class="text-danger">No hay permisos registrados en el sistema.</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-success px-5 btn-lg shadow-sm">
                                <i class="fas fa-save me-2"></i> Guardar Grupo
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg shadow-sm ms-2">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>