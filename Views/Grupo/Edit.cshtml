@model SistemaReserva.Models.Seguridad.Familia

@{
    ViewData["Title"] = "Editar Grupo";
    var permisos = ViewBag.PermisosDisponibles as List<SistemaReserva.Models.Seguridad.Patente>;
    
    // Obtenemos los IDs de los permisos que este grupo YA tiene, para tildarlos automáticamente
    var permisosActualesIds = Model.Hijos.Select(h => h.IdComponente).ToList();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i> Modificar Grupo</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="id" value="@Model.IdComponente" />
                        
                        <div class="mb-4">
                            <label for="nombre" class="form-label fw-bold">Nombre del Grupo</label>
                            <input type="text" class="form-control form-control-lg" id="nombre" name="nombre" value="@Model.Nombre" required autocomplete="off" />
                        </div>

                        <div class="bg-light p-3 rounded border">
                            <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary">Permisos Asignados</h5>
                            <div class="row">
                                @if (permisos != null && permisos.Any())
                                {
                                    foreach (var permiso in permisos)
                                    {
                                        // Verificamos si este permiso en particular está en la lista de permisos que ya tiene el grupo
                                        bool estaTildado = permisosActualesIds.Contains(permiso.IdComponente);
                                        
                                        <div class="col-md-6 mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input fs-5" type="checkbox" name="permisosSeleccionados" value="@permiso.IdComponente" id="permiso_@permiso.IdComponente" @(estaTildado ? "checked" : "")>
                                                <label class="form-check-label pt-1 ms-2 user-select-none" for="permiso_@permiso.IdComponente" style="cursor: pointer;">
                                                    @permiso.Nombre
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-warning px-5 btn-lg shadow-sm">
                                <i class="fas fa-sync-alt me-2"></i> Actualizar Grupo
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg shadow-sm ms-2">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>