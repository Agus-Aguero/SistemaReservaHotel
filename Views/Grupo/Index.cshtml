@model IEnumerable<SistemaReserva.Models.Seguridad.Familia>

@{
    ViewData["Title"] = "Gestión de Grupos de Seguridad";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold text-primary">
                <i class="fas fa-users-cog me-2"></i>Gestión de Grupos
            </h1>
            <p class="lead text-muted">Administración de roles y permisos del sistema.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                <i class="fas fa-plus-circle me-2"></i> Crear Nuevo Grupo
            </a>
        </div>
    </div>

    @* ALERTAS DE ÉXITO O ERROR *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="ps-4 py-3">Nombre del Grupo (Rol)</th>
                        <th class="text-end pe-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="2" class="text-center py-4 text-muted">
                                No hay grupos registrados en el sistema.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 align-middle fw-bold">
                                    <i class="fas fa-shield-alt text-secondary me-2"></i> @item.Nombre
                                </td>
                                <td class="text-end pe-4 align-middle">
                                    <a asp-action="Edit" asp-route-id="@item.IdComponente" class="btn btn-warning btn-sm shadow-sm text-dark me-2">
                                        <i class="fas fa-edit"></i> Editar Permisos
                                    </a>
                                    
                                    @* Botón de eliminar seguro por POST *@
                                    <form asp-action="Delete" asp-route-id="@item.IdComponente" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de que deseas eliminar el grupo @item.Nombre? Esta acción no se puede deshacer.');">
                                        <button type="submit" class="btn btn-danger btn-sm shadow-sm">
                                            <i class="fas fa-trash-alt"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>