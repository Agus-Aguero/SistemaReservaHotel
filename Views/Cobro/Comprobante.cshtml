@model SistemaReserva.Models.Cobro

@{
    ViewData["Title"] = "Comprobante de Operación";
}

<div class="container mt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    
                    <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
                    <h2 class="mt-4 text-success">¡Operación Exitosa!</h2>
                    
                    @if (TempData["Success"] != null)
                    {
                        <p class="lead mt-3 text-muted">@TempData["Success"]</p>
                    }

                    <div class="text-start bg-light p-4 rounded mt-4">
                        <p class="mb-2"><strong>Reserva #:</strong> @Model.IdReserva</p>
                        @if (Model.MonedaPago == "USD")
                        {
                            <p class="mb-2">
                                <strong>Monto:</strong> <span class="text-success fw-bold">USD @Model.MontoEnDolares?.ToString("N2")</span>
                                <br>
                                <small class="text-muted">
                                    (Equivalente a $@Model.MontoTotal.ToString("N2") ARS - Cotización aplicada: $@Model.CotizacionAplicada?.ToString("N2"))
                                </small>
                            </p>
                        }
                        else
                        {
                            <p class="mb-2"><strong>Monto:</strong> $@Model.MontoTotal.ToString("N2") ARS</p>
                        }
                        <p class="mb-2"><strong>Método:</strong> @Model.MetodoPago</p>
                        <p class="mb-2"><strong>Estado:</strong> <span class="badge bg-info text-dark">@Model.Estado</span></p>
                        
                        @if (Model.MetodoPago.Contains("Tarjeta"))
                        {
                            <p class="mb-0"><strong>Tarjeta:</strong> @Model.MarcaTarjeta terminada en @Model.Ultimos4Digitos</p>
                        }
                    </div>

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al Inicio</a>
                        <button class="btn btn-outline-secondary ms-2" onclick="window.print()"><i class="fas fa-print"></i> Imprimir</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>