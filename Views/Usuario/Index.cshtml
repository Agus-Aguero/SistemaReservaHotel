@model IEnumerable<SistemaReserva.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold text-primary">
                <i class="fas fa-users me-2"></i>Gestión de Usuarios
            </h1>
            <p class="lead text-muted">Auditoría de cuentas, roles y blanqueo de contraseñas.</p>
        </div>
        </div>

    @* ALERTAS DE ÉXITO O ERROR *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="ps-4 py-3">Email (Usuario)</th>
                        <th class="py-3">Grupos Asignados (Roles)</th>
                        <th class="text-end pe-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                No hay usuarios registrados en la base de datos.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 align-middle fw-bold">
                                    <i class="fas fa-user-circle text-secondary me-2"></i> @item.Email
                                </td>
                                <td class="align-middle">
                                    @* Mostramos todos los grupos que tiene este usuario *@
                                    @if (item.Grupos != null && item.Grupos.Any())
                                    {
                                        foreach (var grupo in item.Grupos)
                                        {
                                            <span class="badge bg-primary me-1 fs-6 shadow-sm">@grupo.Nombre</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6 shadow-sm">Sin Accesos</span>
                                    }
                                </td>
                                <td class="text-end pe-4 align-middle">
                                    @* Botón para ir a tildar/destildar roles *@
                                    <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-warning btn-sm shadow-sm text-dark me-2">
                                        <i class="fas fa-user-tag"></i> Roles
                                    </a>
                                    
                                    @* BOTÓN DE RESETEO DE CLAVE (Requerimiento del examen) *@
                                    <form asp-action="ResetearClave" asp-route-id="@item.IdUsuario" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de que deseas resetear la contraseña de @item.Email a \'1234\'?');">
                                        <button type="submit" class="btn btn-danger btn-sm shadow-sm">
                                            <i class="fas fa-key"></i> Resetear Clave
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>