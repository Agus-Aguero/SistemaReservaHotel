@model SistemaReserva.Models.Usuario

@{
    ViewData["Title"] = "Asignar Accesos al Usuario";
    var grupos = ViewBag.GruposDisponibles as List<SistemaReserva.Models.Seguridad.Familia>;
    var gruposActualesIds = Model.Grupos.Select(g => g.IdComponente).ToList();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white">
                    <h3 class="mb-0"><i class="fas fa-user-lock me-2"></i> Gestión de Accesos</h3>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4 p-3 bg-light rounded border">
                        <h5 class="fw-bold text-secondary">Usuario Seleccionado</h5>
                        <p class="fs-5 mb-0 text-primary fw-bold">@Model.Email</p>
                    </div>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="id" value="@Model.IdUsuario" />

                        <div class="bg-white p-3 rounded border mb-4">
                            <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary">Asignar Grupos (Roles)</h5>
                            <div class="row">
                                @if (grupos != null && grupos.Any())
                                {
                                    foreach (var grupo in grupos)
                                    {
                                        bool estaTildado = gruposActualesIds.Contains(grupo.IdComponente);
                                        
                                        <div class="col-md-6 mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input fs-5" type="checkbox" name="gruposSeleccionados" value="@grupo.IdComponente" id="grupo_@grupo.IdComponente" @(estaTildado ? "checked" : "")>
                                                <label class="form-check-label pt-1 ms-2 user-select-none fw-bold" for="grupo_@grupo.IdComponente" style="cursor: pointer;">
                                                    @grupo.Nombre
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12">
                                        <p class="text-danger">No hay grupos creados en el sistema.</p>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-success px-5 btn-lg shadow-sm">
                                <i class="fas fa-save me-2"></i> Guardar Accesos
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg shadow-sm ms-2">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>