@using System.Text.Json
@model IEnumerable<SistemaReserva.Models.AuditoriaReserva>

@{
    ViewData["Title"] = "Trazabilidad de Reservas";
}

@functions {
    public List<string> ObtenerDiferencias(string jsonOriginal, string jsonNuevo)
    {
        var diferencias = new List<string>();
        
        if (string.IsNullOrEmpty(jsonOriginal) || string.IsNullOrEmpty(jsonNuevo) || jsonOriginal == "N/A" || jsonNuevo == "N/A")
            return diferencias;

        // Diccionario para traducir nombres técnicos a nombres amigables
        var traductorNombres = new Dictionary<string, string>
        {
            { "Estado", "Estado de la Reserva" },
            { "IdHabitacion", "N° de Habitación" },
            { "PrecioTotal", "Monto Total" },
            { "EstadoPago", "Estado del Pago" }, 
            { "MetodoPago", "Método de Pago" }
        };

        try
        {
            var dictOriginal = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(jsonOriginal);
            var dictNuevo = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(jsonNuevo);

            if (dictOriginal != null && dictNuevo != null)
            {
                foreach (var key in dictNuevo.Keys)
                {
                    // Ignoramos campos técnicos que al usuario no le importan
                    if (key == "IdReserva" || key == "IdUsuario" || key == "IdPersona") continue;

                    // Manejo seguro de Nulos (Null)
                    var valOriginal = dictOriginal.ContainsKey(key) && dictOriginal[key].ValueKind != JsonValueKind.Null 
                        ? dictOriginal[key].ToString() : "Sin asignar";
                        
                    var valNuevo = dictNuevo[key].ValueKind != JsonValueKind.Null 
                        ? dictNuevo[key].ToString() : "Sin asignar";

                    // Si el valor cambió, armamos el HTML
                    if (valOriginal != valNuevo)
                    {
                        string nombreLindo = traductorNombres.ContainsKey(key) ? traductorNombres[key] : key;
                        diferencias.Add($"<span class='text-secondary fw-bold'>{nombreLindo}:</span> <span class='text-danger text-decoration-line-through mx-1'>{valOriginal}</span> <i class='fas fa-arrow-right text-muted mx-1'></i> <span class='text-success fw-bold bg-success bg-opacity-10 px-2 rounded'>{valNuevo}</span>");
                    }
                }
            }
        }
        catch
        {
            diferencias.Add("<span class='text-warning'>Formato ilegible.</span>");
        }
        
        return diferencias;
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0"><i class="fas fa-history text-primary me-2"></i> Trazabilidad de Reservas</h1>
        <p class="text-muted mt-1">Auditoría detallada de todos los cambios de estado y modificaciones.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i> Volver al Inicio
    </a>
</div>

<hr />

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Fecha y Hora</th>
                        <th>Reserva N°</th>
                        <th>Usuario Responsable</th>
                        <th class="text-center">Operación</th>
                        <th>Detalle de Modificaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-file-invoice fa-3x mb-3"></i>
                                <h5>No hay movimientos registrados</h5>
                                <p>Aún no se han creado ni modificado reservas.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-nowrap">
                                    <i class="far fa-calendar-alt text-muted me-1"></i> 
                                    @item.FechaHora.ToString("dd/MM/yyyy") 
                                    <span class="ms-2 fw-bold">@item.FechaHora.ToString("HH:mm")</span>
                                </td>
                                
                                <td class="fw-bold fs-5">#@item.IdReserva</td>
                                
                                <td>@item.EmailUsuario</td>
                                
                                <td class="text-center">
                                    @{
                                        var colorOp = item.TipoOperacion switch {
                                            "CREACIÓN" => "bg-primary",
                                            "MODIFICACIÓN" => "bg-warning text-dark",
                                            "ELIMINACIÓN" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @colorOp px-3 py-2">@item.TipoOperacion</span>
                                </td>
                                
                                <td>
                                    @if (item.TipoOperacion == "MODIFICACIÓN")
                                    {
                                        var cambios = ObtenerDiferencias(item.ValoresOriginales, item.ValoresNuevos);
                                        
                                        if (cambios.Any())
                                        {
                                            <ul class="list-unstyled mb-0 lh-lg">
                                                @foreach (var cambio in cambios)
                                                {
                                                    @* El Html.Raw es vital para que las etiquetas <span> y <i> se rendericen como HTML y no como texto plano *@
                                                    <li>@Html.Raw(cambio)</li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Sin cambios detectables en campos auditables.</span>
                                        }
                                    }
                                    else if (item.TipoOperacion == "CREACIÓN")
                                    {
                                        <span class="text-success fw-bold"><i class="fas fa-plus-circle me-1"></i> Registro Inicial</span>
                                    }
                                    else if (item.TipoOperacion == "ELIMINACIÓN")
                                    {
                                        <span class="text-danger fw-bold"><i class="fas fa-trash-alt me-1"></i> Registro Eliminado</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Paginación de Auditoría" class="mt-4">
        <ul class="pagination justify-content-center">
            
            <!-- Botón Anterior -->
            <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Reservas" asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                    <i class="fas fa-chevron-left me-1"></i> Anterior
                </a>
            </li>

            <!-- Números de Página -->
            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Reservas" asp-route-pagina="@i">@i</a>
                </li>
            }

            <!-- Botón Siguiente -->
            <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Reservas" asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                    Siguiente <i class="fas fa-chevron-right ms-1"></i>
                </a>
            </li>
            
        </ul>
    </nav>
}