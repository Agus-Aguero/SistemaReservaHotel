@model IEnumerable<SistemaReserva.Models.AuditoriaSesion>

@{
    ViewData["Title"] = "Auditoría de Sesiones";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0"><i class="fas fa-user-shield text-primary me-2"></i> Auditoría de Accesos</h1>
        <p class="text-muted mt-1">Registro histórico de inicios y cierres de sesión en el sistema.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i> Volver al Inicio
    </a>
</div>

<hr />

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Fecha y Hora</th>
                        <th>Usuario (Email)</th>
                        <th class="text-center">Evento Registrado</th>
                        <th>Detalles del Sistema</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-inbox fa-3x mb-3"></i>
                                <h5>No hay registros de actividad</h5>
                                <p>Aún no se han registrado inicios o cierres de sesión.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-nowrap">
                                    <i class="far fa-calendar-alt text-muted me-1"></i> 
                                    @item.FechaHora.ToString("dd/MM/yyyy") 
                                    <span class="ms-2 fw-bold">@item.FechaHora.ToString("HH:mm:ss")</span>
                                </td>
                                <td class="fw-bold">
                                    @item.EmailUsuario
                                </td>
                                <td class="text-center">
                                    @{
                                        var badgeClass = item.TipoEvento switch
                                        {
                                            "LOGIN EXITOSO" => "bg-success",
                                            "LOGIN FALLIDO" => "bg-danger",
                                            "LOGOUT" => "bg-secondary",
                                            _ => "bg-info text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass px-3 py-2 rounded-pill">
                                        @item.TipoEvento
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">@item.Detalles</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- 👇 CONTROLES DE PAGINACIÓN 👇 -->
@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Paginación de Sesiones" class="mt-4">
        <ul class="pagination justify-content-center">
            
            <!-- Botón Anterior -->
            <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
                <!-- OJO: Revisá que el asp-action coincida con el nombre de tu método -->
                <a class="page-link" asp-action="Sesiones" asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                    <i class="fas fa-chevron-left me-1"></i> Anterior
                </a>
            </li>

            <!-- Números de Página -->
            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Sesiones" asp-route-pagina="@i">@i</a>
                </li>
            }

            <!-- Botón Siguiente -->
            <li class="page-item @(ViewBag.PaginaActual == ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Sesiones" asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                    Siguiente <i class="fas fa-chevron-right ms-1"></i>
                </a>
            </li>
            
        </ul>
    </nav>
}